<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" targetNamespace="http://sinac.cinvestav.mx">
<process id="sinac_examen_v1" name="Examen en línea SINAC" isExecutable="true" camunda:historyTimeToLive="365"><startEvent id="inicio" name="Examen programado"/><sequenceFlow id="a" sourceRef="inicio" targetRef="presentar"/><userTask id="presentar" name="Presentar examen" camunda:candidateGroups="aspirantes"/><sequenceFlow id="b" sourceRef="presentar" targetRef="evaluar"/><serviceTask id="evaluar" name="Evaluar respuestas" camunda:expression="${true}"/><sequenceFlow id="c" sourceRef="evaluar" targetRef="fin"/><endEvent id="fin" name="Examen evaluado"/></process></definitions>
