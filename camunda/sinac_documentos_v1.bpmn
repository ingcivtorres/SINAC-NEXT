<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" targetNamespace="http://sinac.cinvestav.mx">
  <message id="msgDocumentoCargado" name="DocumentoCargado"/>
  <process id="sinac_documentos_v1" name="Validación de documentos SINAC" isExecutable="true" camunda:historyTimeToLive="365">
    <startEvent id="inicio" name="Documento cargado">
      <messageEventDefinition messageRef="msgDocumentoCargado"/>
    </startEvent>
    <sequenceFlow id="a" sourceRef="inicio" targetRef="validar"/>
    <userTask id="validar" name="Validar documento" camunda:candidateGroups="coordinacion"/>
    <sequenceFlow id="b" sourceRef="validar" targetRef="decision"/>
    <exclusiveGateway id="decision" name="¿Documento válido?" default="no"/>
    <sequenceFlow id="ok" sourceRef="decision" targetRef="aceptado">
      <conditionExpression xsi:type="tFormalExpression">${valido == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="no" sourceRef="decision" targetRef="rechazado"/>
    <endEvent id="aceptado" name="Documento aceptado"/>
    <endEvent id="rechazado" name="Solicitar corrección"/>
  </process>
</definitions>
