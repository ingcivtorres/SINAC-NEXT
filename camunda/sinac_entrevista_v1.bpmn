<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" targetNamespace="http://sinac.cinvestav.mx">
<process id="sinac_entrevista_v1" name="Entrevista virtual SINAC" isExecutable="true" camunda:historyTimeToLive="365"><startEvent id="inicio" name="Entrevista programada"/><sequenceFlow id="a" sourceRef="inicio" targetRef="sala"/><serviceTask id="sala" name="Preparar sala" camunda:expression="${true}"/><sequenceFlow id="b" sourceRef="sala" targetRef="entrevista"/><userTask id="entrevista" name="Realizar entrevista" camunda:candidateGroups="coordinacion"/><sequenceFlow id="c" sourceRef="entrevista" targetRef="fin"/><endEvent id="fin" name="Entrevista completada"/></process></definitions>
