<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" targetNamespace="http://sinac.cinvestav.mx">
  <process id="sinac_preregistro_v1" name="Preregistro SINAC NEXT" isExecutable="true" camunda:historyTimeToLive="365">
    <startEvent id="inicio" name="Aspirante registrado"/>
    <sequenceFlow id="f1" sourceRef="inicio" targetRef="revision"/>
    <userTask id="revision" name="Revisar expediente de aspirante" camunda:candidateGroups="coordinacion"/>
    <sequenceFlow id="f2" sourceRef="revision" targetRef="fin"/>
    <endEvent id="fin" name="Expediente enviado a seguimiento"/>
  </process>
</definitions>
