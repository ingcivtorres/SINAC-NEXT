<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" targetNamespace="http://sinac.cinvestav.mx">
<process id="sinac_documentos_v1" name="Validación de documentos SINAC" isExecutable="true" camunda:historyTimeToLive="365">
<startEvent id="inicio" name="Documento cargado"/><sequenceFlow id="a" sourceRef="inicio" targetRef="validar"/><userTask id="validar" name="Validar documento" camunda:candidateGroups="coordinacion"/><sequenceFlow id="b" sourceRef="validar" targetRef="decision"/><exclusiveGateway id="decision" name="¿Documento válido?"/><sequenceFlow id="ok" sourceRef="decision" targetRef="aceptado"><conditionExpression xsi:type="tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${valido == true}</conditionExpression></sequenceFlow><sequenceFlow id="no" sourceRef="decision" targetRef="rechazado"><conditionExpression xsi:type="tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${valido == false}</conditionExpression></sequenceFlow><endEvent id="aceptado" name="Documento aceptado"/><endEvent id="rechazado" name="Solicitar corrección"/>
</process></definitions>
