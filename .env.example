# Copia este archivo como .env y ajusta los valores antes de desplegar.
# Nunca subas el archivo .env al repositorio.

# Producción: DJANGO_DEBUG=false exige una clave de al menos 50 caracteres.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=

# Dominios desde los que se atiende el sistema (separados por comas).
DJANGO_ALLOWED_HOSTS=sinac.ejemplo.mx,localhost
DJANGO_CORS_ORIGINS=https://sinac.ejemplo.mx

# Activa cookies seguras, HSTS y redirección a HTTPS cuando haya TLS delante de nginx.
DJANGO_HTTPS=true
# HSTS: incluir subdominios (recomendado) y solicitar precarga en navegadores (irreversible a corto plazo).
DJANGO_HSTS_SUBDOMAINS=true
DJANGO_HSTS_PRELOAD=false
# Dirección pública del sistema; se usa en los enlaces de recuperación de contraseña.
SINAC_URL_PUBLICA=https://sinac.example.edu.mx

# Credenciales de PostgreSQL (obligatorias; cámbialas antes del primer arranque).
POSTGRES_DB=camunda
POSTGRES_USER=camunda
POSTGRES_PASSWORD=

# Cuenta de servicio con la que el backend usa la API REST de Camunda.
# Después de arrancar ejecuta: docker compose exec backend python manage.py configurar_camunda
CAMUNDA_USER=sinacbackend
CAMUNDA_PASSWORD=

# Servidor de correo para las notificaciones.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Días que se conservan los respaldos diarios en ./respaldos.
# RESPALDOS_DIAS=14

# Límites opcionales de peticiones.
# THROTTLE_LOGIN=10/minute
# THROTTLE_REGISTRO=5/hour
# JWT_ACCESS_MINUTES=120
